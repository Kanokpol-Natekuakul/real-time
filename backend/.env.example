# Server Port
PORT=3001

# MongoDB Connection String
# Get this from MongoDB Atlas (e.g. mongodb+srv://<username>:<password>@cluster0.mongodb.net/database_name)
MONGO_URI=mongodb://localhost:27017/realtime-editor

# Firebase Admin SDK configuration
# 1. Go to Firebase Console -> Project Settings -> Service Accounts
# 2. Click "Generate new private key"
# 3. Save the downloaded JSON file as 'serviceAccountKey.json' in this backend/ directory
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
